# ============================================================================
# 66th 参展申请列表（导出服务）—— 生产配置
#
# 放到服务器：/verifly/activity-export/export.env
# 权限：chmod 600
#
# ⚠️ 三条铁律
#   1. docker --env-file 不支持行尾注释！注释必须单独占一行
#   2. 值不要加引号，不要有空格
#   3. 这里写的是【容器内路径】，宿主机路径由 deploy/run.sh 的 -v 决定
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 数据源（只读！必须用只读账号）
# ---------------------------------------------------------------------------
# 主机必须是 127.0.0.1 —— 容器用 --network host 直接连宿主机 MySQL
# 用户名 exporter 需要是只有 SELECT 权限的账号
DATABASE_URL=mysql://exporter:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/verifly_signup?charset=utf8mb4

# 容器内挂载点，不要改（run.sh 会把 /verifly/activity/uploads 挂到这里，且是只读）
UPLOAD_DIR=/data/uploads

# 审计日志在容器内的路径（run.sh 会挂载 /verifly/activity-export/audit）
AUDIT_LOG_PATH=/data/audit/audit.jsonl

# ---------------------------------------------------------------------------
# 2. 鉴权（必填）
# ---------------------------------------------------------------------------
# 页面登录和下载链接都用它。生成方式：
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
# 不要用 $ " ' 空格 等特殊字符
EXPORT_TOKEN=CHANGE_ME_40_CHARS_RANDOM

# 同一 IP 连续输错几次锁 5 分钟
LOGIN_MAX_ATTEMPTS=10

# ---------------------------------------------------------------------------
# 3. 导出限制（随时可改，重启生效）
# ---------------------------------------------------------------------------
# 单次最多勾选几条报名
MAX_EXPORT_RECORDS=10

# 单次打包附件合计上限（MB）
MAX_EXPORT_MB=300

# 每个 IP 每分钟最多导出几次
EXPORT_PER_MIN=30

# 同时进行的打包任务上限，超出的直接拒绝（不排队）
MAX_CONCURRENT_EXPORTS=2

# 列表分页
PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# 4. 展示与安全
# ---------------------------------------------------------------------------
SITE_TITLE=参展申请列表｜66th & 2nd Ave.
EVENT_NAME=66th & 2nd Vintage Fashion Show & Market

# 生产保持 0：关闭 /docs /redoc /openapi.json
ENABLE_DOCS=0

# 允许的跨域来源。同域部署保持 * 即可；如需收紧写成逗号分隔的白名单
ALLOWED_ORIGINS=*

# 容器时区（审计日志时间按这个走）
TZ=Asia/Shanghai
